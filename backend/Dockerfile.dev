# Imagem de desenvolvimento: roda com hot reload (tsx watch).
# O código é sincronizado pelo "docker compose up --watch".
FROM node:22-bookworm-slim

WORKDIR /app

# openssl é exigido pelo Prisma
RUN apt-get update && apt-get install -y --no-install-recommends openssl && rm -rf /var/lib/apt/lists/*

COPY package*.json ./
RUN npm ci

COPY . .
RUN npx prisma generate

EXPOSE 3333

# Sincroniza o schema com o banco e sobe a API em modo watch
CMD ["sh", "-c", "npx prisma generate && npx prisma db push && npm run dev"]
